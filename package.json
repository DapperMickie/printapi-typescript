{
  "name": "printapi-sdk",
  "version": "0.1.0",
  "description": "Typed, fetch-based SDK for the complete PrintAPI v2 API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openapi": "./openapi/printapi-v2.json"
  },
  "files": [
    "dist",
    "openapi/printapi-v2.json",
    "README.md",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs",
    "spec:update": "node scripts/update-spec.mjs",
    "spec:check": "node scripts/update-spec.mjs --check",
    "generated:check": "node scripts/generate.mjs --check",
    "check": "npm run generated:check && npm run typecheck && npm test && npm run build && npm run test:package",
    "prepack": "npm run check",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "openapi-typescript": "7.13.0",
    "tsdown": "0.23.7",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DapperMickie/printapi-typescript.git"
  },
  "homepage": "https://github.com/DapperMickie/printapi-typescript#readme",
  "bugs": {
    "url": "https://github.com/DapperMickie/printapi-typescript/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "printapi",
    "sdk",
    "typescript",
    "printing",
    "web-to-print",
    "bun"
  ]
}
